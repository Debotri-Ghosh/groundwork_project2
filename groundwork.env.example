# ============================================================
# Groundwork — environment config (Option B: Docker mode)
# All services run via docker-compose: Qdrant server + PostgreSQL.
# No local data files — data lives in Docker-managed volumes.
# Copy this file to `.env` and fill in values.
# ============================================================

# --- LLM provider selection ---
# One of: openai | ollama | azure_openai
LLM_PROVIDER=openai

# --- OpenAI / OpenAI-compatible (Groq, etc.) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=                    # leave empty for official OpenAI
OPENAI_MODEL=openai/gpt-oss-20b

# --- Ollama (only needed if LLM_PROVIDER=ollama) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# --- Application ---
APP_ENV=development

# --- Embedding model ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ============================================================
# QDRANT — Vector DB (Docker server mode)
# Started with: docker compose up -d
# ============================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ============================================================
# POSTGRES — Relational DB (Docker server mode)
# Started with: docker compose up -d
# ============================================================
DATABASE_URL=postgresql+psycopg2://groundwork_user:groundwork_pass@localhost:5432/groundwork_db
POSTGRES_USER=groundwork_user
POSTGRES_PASSWORD=groundwork_pass
POSTGRES_DB=groundwork_db