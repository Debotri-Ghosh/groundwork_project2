# ============================================================
# Groundwork — environment config
# Fills in the vars check_setup.py actually looks for.
# Two modes below: pick ONE block per service depending on
# whether Docker/WSL is available yet.
# ============================================================

# --- OpenAI (only needed if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=

# --- Ollama (only needed if LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM provider selection ---
# One of: openai | ollama | azure_openai
LLM_PROVIDER=ollama

# --- Azure OpenAI (only needed if LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# --- Application ---
APP_ENV=development

# --- Embedding model ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ============================================================
# QDRANT — Vector DB
# ============================================================
# OPTION A: No Docker yet (local embedded Qdrant, file-based)
#   In code: QdrantClient(path=os.getenv("QDRANT_LOCAL_PATH"))
QDRANT_LOCAL_PATH=./qdrant_local_data

# OPTION B: Once Docker/WSL is available, use these instead
#   In code: QdrantClient(host=os.getenv("QDRANT_HOST"), port=int(os.getenv("QDRANT_PORT")))
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ============================================================
# POSTGRES — Relational DB
# ============================================================
# OPTION A: No Docker yet — use SQLite as a drop-in stand-in
DATABASE_URL=sqlite:///./dev.db

# OPTION B: Once Docker/WSL is available, switch to this
# DATABASE_URL=postgresql+psycopg2://groundwork_user:groundwork_pass@localhost:5432/groundwork_db
# POSTGRES_USER=groundwork_user
# POSTGRES_PASSWORD=groundwork_pass
# POSTGRES_DB=groundwork_db
